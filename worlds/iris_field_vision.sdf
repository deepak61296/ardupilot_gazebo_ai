    <include><name>g_0_7</name><pose degrees="true">-82.5 22.5 0.01 0 0 90</pose><uri>model://grass_tile_worn</uri></include>
    <include><name>g_0_8</name><pose degrees="true">-82.5 37.5 0.01 0 0 270</pose><uri>model://grass_tile</uri></include>
    <include><name>g_0_9</name><pose degrees="true">-82.5 52.5 0.01 0 0 90</pose><uri>model://grass_tile</uri></include>
