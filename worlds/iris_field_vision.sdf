    <include><name>g_1_0</name><pose degrees="true">-67.5 -82.5 0.01 0 0 90</pose><uri>model://grass_tile</uri></include>
    <include><name>g_1_1</name><pose degrees="true">-67.5 -67.5 0.01 0 0 0</pose><uri>model://grass_tile</uri></include>
    <include><name>g_1_2</name><pose degrees="true">-67.5 -52.5 0.01 0 0 180</pose><uri>model://grass_tile</uri></include>
