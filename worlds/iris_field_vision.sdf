<?xml version="1.0" ?>
<!-- Realistic outdoor field for vision demos (search / find / approach / precision-land).
     iris_with_gimbal + ArduPilotPlugin (udp:9002) + NavSat, on a PBR grass-textured field with
     trees, buildings, roads and cars. World name stays "iris_runway" so the camera-stream topic
     is unchanged. GENERATED by scripts/gen_field_world.py (edit there, not here).
     Grass/road tiles are repo-local PBR models (textures from scripts/gen_textures.py,
     ogre2-safe); trees are repo-local too, so the only asset fetched at launch is the walking
     person's Fuel mesh (once, then cached). Launch with GZ_SIM_RESOURCE_PATH including
     ardupilot_gazebo/models and this repo's models. -->
<sdf version="1.9">
  <world name="iris_runway">
    <physics name="1ms" type="ignore">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/>

    <!-- daylight + a sky + light distance fog for depth; bright enough for colour/ArUco detection -->
    <scene>
      <ambient>0.55 0.55 0.58 1</ambient>
      <background>0.7 0.8 0.95</background>
      <sky></sky>
      <shadows>true</shadows>
      <fog><type>linear</type><color>0.78 0.84 0.92 1</color><density>0.0016</density>
        <start>60</start><end>400</end></fog>
    </scene>

    <spherical_coordinates>
      <latitude_deg>-35.363262</latitude_deg>
      <longitude_deg>149.165237</longitude_deg>
      <elevation>584</elevation>
      <heading_deg>0</heading_deg>
      <surface_model>EARTH_WGS84</surface_model>
    </spherical_coordinates>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1.0 0.98 0.92 1</diffuse>
      <specular>0.4 0.4 0.38 1</specular>
      <attenuation>
        <range>2000</range><constant>0.9</constant><linear>0.005</linear><quadratic>0.0005</quadratic>
      </attenuation>
      <direction>-0.4 0.25 -0.88</direction>
    </light>

    <!-- collision base (invisible); the visible far ground is the textured far_field plane
         so the horizon shows farmland variation instead of a flat colour. -->
    <model name="ground">
      <static>true</static>
      <link name="link">
        <collision name="c">
          <geometry><plane><normal>0 0 1</normal><size>2000 2000</size></plane></geometry>
        </collision>
      </link>
    </model>
    <include>
      <name>far_ground</name>
      <pose>0 0 0.003 0 0 0</pose>
      <uri>model://far_field</uri>
    </include>

    <include>
      <uri>model://iris_with_gimbal</uri>
      <pose degrees="true">0 0 0.195 0 0 90</pose>
    </include>

    <!-- ==== search / land targets ==== -->
    <model name="red_pad">
      <static>true</static>
      <pose>0 10 0.03 0 0 0</pose>
      <link name="l"><visual name="v">
        <geometry><box><size>3 3 0.04</size></box></geometry>
        <material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse><emissive>0.4 0 0 1</emissive></material>
      </visual></link>
    </model>
    <include>
      <uri>model://aruco_marker</uri>
      <pose>0 3 0.03 0 0 0</pose>
    </include>
    <model name="blue_box">
      <static>true</static>
      <pose>10 0 1 0 0 0</pose>
      <link name="l"><visual name="v">
        <geometry><box><size>2 2 2</size></box></geometry>
        <material><ambient>0 0 1 1</ambient><diffuse>0 0 1 1</diffuse>
          <pbr><metal><roughness>0.6</roughness><metalness>0.0</metalness></metal></pbr></material>
      </visual></link>
    </model>
    <model name="yellow_box">
      <static>true</static>
      <pose>-8 -6 1 0 0 0</pose>
      <link name="l"><visual name="v">
        <geometry><box><size>2 2 2</size></box></geometry>
        <material><ambient>1 1 0 1</ambient><diffuse>1 1 0 1</diffuse>
          <pbr><metal><roughness>0.6</roughness><metalness>0.0</metalness></metal></pbr></material>
      </visual></link>
    </model>

    <include><name>g_0_0</name><pose degrees="true">-82.5 -82.5 0.01 0 0 0</pose><uri>model://grass_tile_worn</uri></include>
    <include><name>g_0_1</name><pose degrees="true">-82.5 -67.5 0.01 0 0 90</pose><uri>model://grass_tile</uri></include>
    <include><name>g_0_2</name><pose degrees="true">-82.5 -52.5 0.01 0 0 270</pose><uri>model://grass_tile</uri></include>
    <include><name>g_0_3</name><pose degrees="true">-82.5 -37.5 0.01 0 0 90</pose><uri>model://grass_tile</uri></include>
    <include><name>g_0_4</name><pose degrees="true">-82.5 -22.5 0.01 0 0 270</pose><uri>model://grass_tile</uri></include>
    <include><name>g_0_5</name><pose degrees="true">-82.5 -7.5 0.01 0 0 90</pose><uri>model://grass_tile</uri></include>
