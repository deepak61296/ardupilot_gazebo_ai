<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="helipad">
    <static>true</static>

    <!-- White pad. Sits just above the ground plane so it does not z-fight with it. -->
    <link name="pad">
      <pose>0 0 0.01 0 0 0</pose>
      <visual name="pad_visual">
        <geometry>
          <cylinder>
            <radius>6.0</radius>
            <length>0.02</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.9 0.9 0.9 1</ambient>
          <diffuse>0.95 0.95 0.95 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
      <collision name="pad_collision">
        <geometry>
          <cylinder>
            <radius>6.0</radius>
            <length>0.02</length>
          </cylinder>
        </geometry>
      </collision>
    </link>

    <!-- Red H, drawn as two bars and a crossbar so no texture file is needed. -->
    <link name="h_left">
      <pose>-1.7 0 0.025 0 0 0</pose>
      <visual name="h_left_visual">
        <geometry>
          <box><size>1.1 5.2 0.03</size></box>
        </geometry>
        <material>
          <ambient>0.7 0.1 0.1 1</ambient>
          <diffuse>0.85 0.15 0.15 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="h_right">
      <pose>1.7 0 0.025 0 0 0</pose>
      <visual name="h_right_visual">
        <geometry>
          <box><size>1.1 5.2 0.03</size></box>
        </geometry>
        <material>
          <ambient>0.7 0.1 0.1 1</ambient>
          <diffuse>0.85 0.15 0.15 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="h_bar">
      <pose>0 0 0.025 0 0 0</pose>
      <visual name="h_bar_visual">
        <geometry>
          <box><size>2.3 1.1 0.03</size></box>
        </geometry>
        <material>
          <ambient>0.7 0.1 0.1 1</ambient>
          <diffuse>0.85 0.15 0.15 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- Three coloured markers, 13 m out on different bearings. They give the camera
         something to tell apart, and something for a detection tool to aim at later. -->
    <link name="marker_north">
      <pose>13 0 0.75 0 0 0</pose>
      <visual name="marker_north_visual">
        <geometry>
          <cylinder>
            <radius>0.9</radius>
            <length>1.5</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.8 0.15 0.15 1</ambient>
          <diffuse>0.9 0.2 0.2 1</diffuse>
        </material>
      </visual>
      <collision name="marker_north_collision">
        <geometry>
          <cylinder>
            <radius>0.9</radius>
            <length>1.5</length>
          </cylinder>
        </geometry>
      </collision>
    </link>

    <link name="marker_east">
      <pose>0 13 0.75 0 0 0</pose>
      <visual name="marker_east_visual">
        <geometry>
          <box><size>1.8 1.8 1.5</size></box>
        </geometry>
        <material>
          <ambient>0.1 0.2 0.7 1</ambient>
          <diffuse>0.15 0.3 0.9 1</diffuse>
        </material>
      </visual>
      <collision name="marker_east_collision">
        <geometry>
          <box><size>1.8 1.8 1.5</size></box>
        </geometry>
      </collision>
    </link>

    <link name="marker_west">
      <pose>0 -13 0.9 0 0 0</pose>
      <visual name="marker_west_visual">
        <geometry>
          <sphere><radius>0.9</radius></sphere>
        </geometry>
        <material>
          <ambient>0.8 0.65 0.1 1</ambient>
          <diffuse>0.95 0.8 0.15 1</diffuse>
        </material>
      </visual>
      <collision name="marker_west_collision">
        <geometry>
          <sphere><radius>0.9</radius></sphere>
        </geometry>
      </collision>
    </link>

  </model>
</sdf>
