<?xml version="1.0"?>
<!-- Worn variant of grass_tile (heavier dirt/dry patches). Texture from scripts/gen_textures.py.
     Visual-only; collision lives on the world's ground plane. -->
<sdf version="1.9">
  <model name="grass_tile_worn">
    <static>true</static>
    <link name="link">
      <visual name="v">
        <geometry><plane><normal>0 0 1</normal><size>15 15</size></plane></geometry>
        <material>
          <diffuse>1 1 1 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
          <pbr>
            <metal>
              <albedo_map>materials/textures/grass_worn.png</albedo_map>
              <roughness>0.92</roughness>
              <metalness>0.0</metalness>
            </metal>
          </pbr>
        </material>
      </visual>
    </link>
  </model>
</sdf>
