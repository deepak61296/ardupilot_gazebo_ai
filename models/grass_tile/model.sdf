<?xml version="1.0"?>
<!-- One 15 m grass-textured tile. Uses a PBR albedo_map (renders in Harmonic's ogre2, unlike the
     Fuel Grass Plane's legacy Ogre1 script material). Instanced in a grid to texture the field;
     collision lives on the world's ground plane, so this tile is visual-only. -->
<sdf version="1.9">
  <model name="grass_tile">
    <static>true</static>
    <link name="link">
      <visual name="v">
        <geometry><plane><normal>0 0 1</normal><size>15 15</size></plane></geometry>
        <material>
          <diffuse>1 1 1 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
          <pbr>
            <metal>
              <albedo_map>materials/textures/grass.png</albedo_map>
              <roughness>0.92</roughness>
              <metalness>0.0</metalness>
            </metal>
          </pbr>
        </material>
      </visual>
    </link>
  </model>
</sdf>
