<?xml version="1.0" ?>
<!-- Rounded tree. No mesh, no texture: 40 of these load instantly and need no network. -->
<sdf version="1.9">
  <model name="tree_oak">
    <static>true</static>
    <link name="trunk">
      <pose>0 0 1.6 0 0 0</pose>
      <visual name="v">
        <geometry><cylinder><radius>0.22</radius><length>3.2</length></cylinder></geometry>
        <material><ambient>0.24 0.16 0.09 1</ambient><diffuse>0.33 0.22 0.12 1</diffuse></material>
      </visual>
      <collision name="c">
        <geometry><cylinder><radius>0.22</radius><length>3.2</length></cylinder></geometry>
      </collision>
    </link>
    <link name="canopy">
      <pose>0 0 4.4 0 0 0</pose>
      <visual name="v">
        <geometry><sphere><radius>2.1</radius></sphere></geometry>
        <material><ambient>0.10 0.22 0.08 1</ambient><diffuse>0.16 0.34 0.12 1</diffuse></material>
      </visual>
    </link>
    <link name="canopy_low">
      <pose>0.5 -0.3 3.4 0 0 0</pose>
      <visual name="v">
        <geometry><sphere><radius>1.5</radius></sphere></geometry>
        <material><ambient>0.09 0.20 0.07 1</ambient><diffuse>0.14 0.30 0.10 1</diffuse></material>
      </visual>
    </link>
  </model>
</sdf>
