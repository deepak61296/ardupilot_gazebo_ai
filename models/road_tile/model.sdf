<?xml version="1.0"?>
<!-- One 15 m x 7 m asphalt segment (road axis along x): edge lines + dashed centre line, dash
     period divides 15 m so chained tiles join seamlessly. Texture from scripts/gen_textures.py.
     Visual-only; collision lives on the world's ground plane. -->
<sdf version="1.9">
  <model name="road_tile">
    <static>true</static>
    <link name="link">
      <visual name="v">
        <geometry><plane><normal>0 0 1</normal><size>15 7</size></plane></geometry>
        <material>
          <diffuse>1 1 1 1</diffuse>
          <specular>0.15 0.15 0.15 1</specular>
          <pbr>
            <metal>
              <albedo_map>materials/textures/road.png</albedo_map>
              <roughness>0.8</roughness>
              <metalness>0.0</metalness>
            </metal>
          </pbr>
        </material>
      </visual>
    </link>
  </model>
</sdf>
