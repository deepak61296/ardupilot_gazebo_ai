<?xml version="1.0" ?>
<!-- Conifer, built from tapering cylinders (SDF 1.9 has no cone primitive). -->
<sdf version="1.9">
  <model name="tree_pine">
    <static>true</static>
    <link name="trunk">
      <pose>0 0 1.2 0 0 0</pose>
      <visual name="v">
        <geometry><cylinder><radius>0.18</radius><length>2.4</length></cylinder></geometry>
        <material><ambient>0.22 0.14 0.08 1</ambient><diffuse>0.30 0.20 0.11 1</diffuse></material>
      </visual>
      <collision name="c">
        <geometry><cylinder><radius>0.18</radius><length>2.4</length></cylinder></geometry>
      </collision>
    </link>
    <link name="skirt">
      <pose>0 0 3.1 0 0 0</pose>
      <visual name="v">
        <geometry><cylinder><radius>1.7</radius><length>1.8</length></cylinder></geometry>
        <material><ambient>0.07 0.17 0.07 1</ambient><diffuse>0.11 0.26 0.11 1</diffuse></material>
      </visual>
    </link>
    <link name="mid">
      <pose>0 0 4.6 0 0 0</pose>
      <visual name="v">
        <geometry><cylinder><radius>1.15</radius><length>1.6</length></cylinder></geometry>
        <material><ambient>0.08 0.19 0.08 1</ambient><diffuse>0.12 0.28 0.12 1</diffuse></material>
      </visual>
    </link>
    <link name="top">
      <pose>0 0 5.9 0 0 0</pose>
      <visual name="v">
        <geometry><cylinder><radius>0.55</radius><length>1.4</length></cylinder></geometry>
        <material><ambient>0.09 0.21 0.09 1</ambient><diffuse>0.13 0.30 0.13 1</diffuse></material>
      </visual>
    </link>
  </model>
</sdf>
